node_modules/
.DS_Store

# Build & tool caches
.eslintcache
*.tsbuildinfo
# Extracted sandbox chromium binary (browser tooling artifact — never commit)
.chromium/
dist/
.next/
coverage/
storybook-static/
playwright-report/
test-results/
# Stryker mutation testing (sandbox, log, and generated reports — in any package)
.stryker-tmp/
stryker.log
**/reports/mutation.html
**/reports/mutation/
# jest-image-snapshot diff output — transient (written only on a failing visual
# snapshot; the committed baselines live next to it in __image_snapshots__/).
**/__diff_output__/
**/__received_output__/

# Local env files — real secrets, never commit. Tracked: *.example
.env
.env.local
.env.*.local
!.env.example
!.env.*.example
# The Worker's local secrets (dotenv format, read by `wrangler dev`). It holds the same values
# as `wrangler secret put` — the Supabase service-role key and the Anthropic API key — so it is
# the one file in this repo a real credential is most likely to be typed into by hand.
.dev.vars
.dev.vars.*
