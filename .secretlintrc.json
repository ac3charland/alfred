{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": { "allows": ["/:<password>@/"] }
        }
      ]
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Supabase secret API key",
            "patterns": ["/sb_secret_[A-Za-z0-9_-]{20,}/"]
          },
          {
            "name": "Supabase personal access token",
            "patterns": ["/sbp_[a-f0-9]{40}/"]
          },
          {
            "name": "Postgres password in PGPASSWORD",
            "patterns": ["/PGPASSWORD=['\"]?(?![$<*{])[^\\s'\"]{6,}/"]
          },
          {
            "name": "Password in a libpq conninfo or URL query",
            "patterns": ["/\\bpassword=(?![$<*{])[^\\s'\"&]{6,}/i"]
          },
          {
            "name": "Quoted or spaced password in a conninfo string or assignment",
            "patterns": ["/\\bpassword\\s*=\\s*(?:'(?![$<*{\\[])[^'\\n]{6,}'|\"(?![$<*{\\[])[^\"\\n]{6,}\")/"]
          },
          {
            "name": "Database password in an env-style assignment (not the throwaway `postgres`)",
            "patterns": [
              "/(?:PG|POSTGRES|SUPABASE_DB|DB|DATABASE)_?PASSWORD['\"]?\\s*=\\s*['\"]?(?![$<*{\\[])(?!postgres(?![^\\s'\"]))(?!(?:[A-Za-z_$][\\w$]*\\.)+[\\w$]+\\s*[,})\\];])[^\\s'\"]{6,}/",
              "/(?:PG|POSTGRES|SUPABASE_DB|DB|DATABASE)_?PASSWORD['\"]?\\s*:\\s*['\"]?(?![$<*{\\[])(?!postgres(?![^\\s'\"]))(?![A-Za-z_$][A-Za-z_$.]*\\s*[,})\\];])[^\\s'\"]{6,}/"
            ]
          },
          {
            "name": "Password on a supabase CLI command line (--password / -p)",
            "patterns": [
              "/(?<![\\w\\/.@-])supabase\\s[^\\n;&|]*?\\s(?:--password(?:=|\\s+)|-p\\s+)['\"]?(?![$<*{\\[-])[^\\s'\"]{6,}/"
            ]
          },
          {
            "name": "JSON Web Token (e.g. a legacy Supabase service_role key)",
            "patterns": ["/eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{20,}/"]
          }
        ]
      }
    }
  ]
}
