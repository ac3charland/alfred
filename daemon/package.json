{
  "name": "daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mac-resident dumb pipe: polls iMessage and WorkMail, POSTs HMAC-signed messages to the alfred ingest endpoint.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix --cache --cache-location .eslintcache .",
    "format": "prettier --write --cache .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "start": "node src/main.ts",
    "install:launchd": "node scripts/install-launchd.ts",
    "uninstall:launchd": "node scripts/uninstall-launchd.ts",
    "check:fast": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^14.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23"
  }
}
