# ─────────────────────────────────────────────────────────────────────────────
# alfred frontend (Next.js) environment — TEMPLATE (safe to commit).
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (client-safe) key — new Supabase format `sb_publishable_...`
# (replaces the legacy `anon` JWT). Exposed to the browser; safe with RLS on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key — SERVER-SIDE ONLY. New Supabase format `sb_secret_...`
# (replaces the legacy `service_role` JWT). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy service_role JWT (optional) — SERVER-SIDE ONLY. Only needed for tooling
# that still expects a JWT-format service key.
SUPABASE_SERVICE_ROLE_JWT=

# Shared secret the external/Siri capture ingress must present to POST /api/items.
# Generate with: openssl rand -hex 32
INGEST_API_KEY=

# Postgres connection string — used ONLY for applying migrations and generating types
# (not by the app at runtime).
#
# Use the **Session pooler** URI (Database → Connection string → Session pooler).
# It is IPv4-proxied for free, so it works from any network. Format:
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Avoid the **Direct connection** URI (db.<project-ref>.supabase.co) unless you are on
# an IPv6 network — that host is IPv6-only and will fail DNS/connect on IPv4-only
# machines. The Session pooler is the recommended default going forward.
#
# If the password contains special chars (#, @, etc.), quote the whole value and
# percent-encode them (e.g. # -> %23). See README §3.
DATABASE_URL=

# Vercel access token (OPTIONAL) — used ONLY for CLI deploys (`vercel --prod`), never by
# the app at runtime. Create at Vercel → Account Settings → Tokens, scoped to the team the
# project lives under. With this set, `set -a; . .env.local; set +a; vercel --prod` deploys
# without an interactive login. Server-only secret — keep it out of git (lives in .env.local).
VERCEL_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Code Dashboard GitHub measurements: the rolling seven-day merged-PR split (and
# GET /api/code/pr-ratio) and the lines-changed chart (GET /api/code/loc-velocity).
# The measured repos are the Code module's PROJECTS — each project's repo, oldest
# project first, labelled by the project's name, less any a project row flags
# `exclude_from_pr_ratio` (ratio only; ticked from the card's ⋯ menu). There is no
# repo list to set here.
# All SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, above all the token.
# Leave the token unset and both endpoints answer 501 and neither card renders, so
# a deployment (or local dev) without a token shows a clean Dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Fine-grained PAT used to count merged PRs and read commit statistics. Needs
# **Pull requests: read** (plus **Metadata: read**) on EVERY project's repo: one it
# can't read fails the whole measurement, and both cards show their error note until
# the PAT's repository list is widened. The ratio needs at least two projects (a
# one-repo "ratio" is meaningless); the lines-changed chart needs one.
GITHUB_TOKEN=

# Optional comma-separated GitHub logins whose merged PRs count — the owner, plus
# any bot identity opening PRs on their behalf. Unset counts everyone except the
# known dependency bots (dependabot / renovate / github-actions).
#
# This scopes the RATIO only. The lines-changed chart counts commit authors, not PR
# openers, and always counts everyone except those same dependency bots — an agent
# authoring commits on your behalf is your velocity.
#
# Setting this ALSO switches on the bar's "Other" segment: those logins' merged PRs
# in every repo that is NOT a project's. GitHub Search has no "everywhere except
# these repos" without an anchoring qualifier, so with no allowlist that sweep would
# span all of GitHub — the segment is simply omitted instead. e.g.
#   PR_RATIO_AUTHORS=ac3charland,claude-bot
PR_RATIO_AUTHORS=

# ─────────────────────────────────────────────────────────────────────────────
# Wiki writer (sending Reader picks and knowledge captures into the knowledge
# repo's inbox/). All SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, above all
# the token. Leave them unset (local dev) and the same code hides every send affordance and
# answers 501 on the send routes.
# ─────────────────────────────────────────────────────────────────────────────

# Fine-grained PAT scoped to the wiki repo ONLY, with **Contents: Read and write**.
WIKI_GITHUB_TOKEN=

# The wiki repo as `owner/name`. Also builds the GitHub links raw citations open in.
#   WIKI_REPO=ac3charland/knowledge
WIKI_REPO=

# GitHub's REST origin. Leave unset (https://api.github.com); only the Playwright
# harness points it at its mock server.
WIKI_GITHUB_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Instapaper (the Reader's "Send to Instapaper" verb, POST /api/reader/posts/[id]/instapaper).
# All SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_: together they are the owner's
# Instapaper account. Leave any of the four credentials unset and the route answers 501
# and the Send verb renders disabled ("Instapaper isn't set up on this deployment") —
# e.g. local dev. Set them on the production deployment.
# ─────────────────────────────────────────────────────────────────────────────

# The application's OAuth consumer pair, from instapaper.com/developers/applications/create
# (an app starts in Owner Only mode — enough for a single-user system, no review needed).
INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=

# The owner's access-token pair, minted once with `npm run instapaper:token -w frontend`
# (an xAuth exchange: it asks for the Instapaper username and password, sends them once,
# and never stores the password). A token only works with the consumer key that issued it.
INSTAPAPER_ACCESS_TOKEN=
INSTAPAPER_ACCESS_TOKEN_SECRET=

# Optional. Where the Instapaper API lives; unset means https://www.instapaper.com.
# Only the E2E suite sets it, to point the route at its mock.
INSTAPAPER_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Research (Inbox items classified Research, answered by a Claude Code Routine).
# All SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_. All three, or the feature is off:
# the Inbox offers no Research and the research routes answer 501 — e.g. local dev.
# Setup steps: routines/README.md ("Setting up alfred research").
# ─────────────────────────────────────────────────────────────────────────────

# The alfred research Routine's API trigger, from its page at claude.ai/code/routines:
# the /fire URL and the bearer token that starts that one Routine and nothing else.
RESEARCH_ROUTINE_FIRE_URL=
RESEARCH_ROUTINE_FIRE_TOKEN=

# The key the Routine's session delivers its report with — accepted by
# PUT /api/reader/research/[id] and nothing else (never INGEST_API_KEY's powers). Generate
# once with `openssl rand -hex 32`; the same value goes in the Routine environment's API
# credential for alfred's host, so the session itself never sees it.
RESEARCH_DELIVERY_KEY=
