# ─────────────────────────────────────────────────────────────────────────────
# alfred frontend (Next.js) environment — TEMPLATE (safe to commit).
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (client-safe) key — new Supabase format `sb_publishable_...`
# (replaces the legacy `anon` JWT). Exposed to the browser; safe with RLS on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key — SERVER-SIDE ONLY. New Supabase format `sb_secret_...`
# (replaces the legacy `service_role` JWT). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy service_role JWT (optional) — SERVER-SIDE ONLY. Only needed for tooling
# that still expects a JWT-format service key.
SUPABASE_SERVICE_ROLE_JWT=

# Shared secret the external/Siri capture ingress must present to POST /api/items.
# Generate with: openssl rand -hex 32
INGEST_API_KEY=

# Postgres connection string — used ONLY for applying migrations and generating types
# (not by the app at runtime).
#
# Use the **Session pooler** URI (Database → Connection string → Session pooler).
# It is IPv4-proxied for free, so it works from any network. Format:
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Avoid the **Direct connection** URI (db.<project-ref>.supabase.co) unless you are on
# an IPv6 network — that host is IPv6-only and will fail DNS/connect on IPv4-only
# machines. The Session pooler is the recommended default going forward.
#
# If the password contains special chars (#, @, etc.), quote the whole value and
# percent-encode them (e.g. # -> %23). See README §3.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Instance identity (top-right account/instance switcher). alfred runs as two
# physically-isolated deployments — a Personal and a Work second brain — each its own
# Vercel + Supabase project. These name THIS deployment and point at the other one.
# All are NEXT_PUBLIC_ (read client-side by the header menu). All optional in local dev.
# ─────────────────────────────────────────────────────────────────────────────

# This instance's name, shown in the trigger pill and menu header. Defaults to "alfred".
NEXT_PUBLIC_INSTANCE_LABEL=

# Accent token tinting this instance: teal | amber | blue | green. Defaults to teal.
NEXT_PUBLIC_INSTANCE_ACCENT=

# The other instance's name, shown on its "Open <label>" switch link.
NEXT_PUBLIC_OTHER_INSTANCE_LABEL=

# The other instance's URL. If UNSET, the switch link is hidden (single deployment / local dev).
NEXT_PUBLIC_OTHER_INSTANCE_URL=

# Vercel access token (OPTIONAL) — used ONLY for CLI deploys (`vercel --prod`), never by
# the app at runtime. Create at Vercel → Account Settings → Tokens, scoped to the team the
# project lives under. With this set, `set -a; . .env.local; set +a; vercel --prod` deploys
# without an interactive login. Server-only secret — keep it out of git (lives in .env.local).
VERCEL_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# PR ratio (the Backlog's weekly merged-PR split, and GET /api/code/pr-ratio).
# All SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, above all the token.
# Leave these unset and the endpoint answers 501 and the card renders nothing, so
# a deployment (or local dev) without a token shows a clean Backlog.
# ─────────────────────────────────────────────────────────────────────────────

# Fine-grained PAT used to count merged PRs. Needs only **Pull requests: read**
# (plus **Metadata: read**) on the repos named below.
GITHUB_TOKEN=

# The measured repos, comma-separated, as `owner/name:Label`. Order is preserved —
# it is the left-to-right order of the bar's segments. The `:Label` suffix is
# optional; without it the repo name is used. At least TWO must parse, or the
# feature stays off (a one-repo "ratio" is meaningless). A malformed entry is
# skipped rather than fatal. e.g.
#   PR_RATIO_REPOS=ac3charland/realplay:RealPlay,ac3charland/alfred:Alfred
PR_RATIO_REPOS=

# Optional comma-separated GitHub logins whose merged PRs count — the owner, plus
# any bot identity opening PRs on their behalf. Unset counts everyone except the
# known dependency bots (dependabot / renovate / github-actions).
#
# This scopes the RATIO only. The lines-changed chart counts commit authors, not PR
# openers, and always counts everyone except those same dependency bots — an agent
# authoring commits on your behalf is your velocity.
#
# Setting this ALSO switches on the bar's "Other" segment: those logins' merged PRs
# in every repo NOT listed in PR_RATIO_REPOS. GitHub Search has no "everywhere except
# these repos" without an anchoring qualifier, so with no allowlist that sweep would
# span all of GitHub — the segment is simply omitted instead. e.g.
#   PR_RATIO_AUTHORS=ac3charland,claude-bot
PR_RATIO_AUTHORS=

# ─────────────────────────────────────────────────────────────────────────────
# Instapaper (the Reader's "Send to Instapaper" verb, and POST
# /api/reader/posts/:id/instapaper). All SERVER-SIDE ONLY — never prefix any of
# these with NEXT_PUBLIC_. Leave them unset and the route answers 501 and the row's
# Send verb renders disabled with a title saying so, which is the state local dev and
# the Work instance are both in. ALL FOUR credentials are needed: a partial set reads
# as unset, because three of four would fail at Instapaper with a signature error the
# owner can do nothing about.
#
# Register an application at https://www.instapaper.com/developers/applications/create
# (Owner Only mode is enough and needs no review), then run
#   npm run instapaper:token -w frontend
# which prompts for the consumer key/secret and the Instapaper username/password,
# signs the one-off xAuth exchange and prints the token pair. The password is used for
# that exchange only — nothing stores it, and the app never sees one.
# ─────────────────────────────────────────────────────────────────────────────

# The registered application's OAuth 1.0a consumer credentials.
INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=

# The long-lived access token the exchange above prints, bound to the owner's account.
# A token is tied to the consumer key that issued it — the four values travel together.
INSTAPAPER_ACCESS_TOKEN=
INSTAPAPER_ACCESS_TOKEN_SECRET=

# Optional. Where the Full API lives; defaults to https://www.instapaper.com. Exists so
# the Playwright suite can point the send route at its in-memory mock (see
# playwright.config.ts) — there is no reason to set it on a real deployment.
INSTAPAPER_API_URL=
