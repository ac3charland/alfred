{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/strictest/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
    // No rootDir, unlike the other tools packages: src/prs.ts imports the one alfred-block parser
    // from workers/src/frontmatter.ts rather than forking it.
  },
  "include": ["src"]
}
